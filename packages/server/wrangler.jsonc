{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pd-coop",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "DAILY", "class_name": "DailyBoard" },
      { "name": "WALLET", "class_name": "WalletStore" },
      { "name": "REPORTS", "class_name": "ReportStore" },
      { "name": "PLAYER", "class_name": "Player" },
      { "name": "CARD", "class_name": "Card" },
      { "name": "NOTIFIER", "class_name": "Notifier" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["DailyBoard"] },
    { "tag": "v3", "new_sqlite_classes": ["WalletStore"] },
    { "tag": "v4", "new_sqlite_classes": ["ReportStore"] },
    { "tag": "v5", "new_sqlite_classes": ["Player"] },
    { "tag": "v6", "new_sqlite_classes": ["Card", "Notifier"] }
  ],
  // Every hour: the bot's reminders that are due (notifier.ts).
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    // Players outside Telegram (a plain browser) may join rooms as guests.
    "ALLOW_GUESTS": "true",
    // The Mini App's t.me link: the bot's play button.
    "APP_LINK": "https://t.me/pixel_dungeon_gamebot/pixel_dungeon",
    // The terms page the bot's /terms points to (the client's public/terms.html).
    "TERMS_URL": "https://shiba-vibecoding.github.io/pixel-dungeon-telegram/terms.html",
    // The admin's Telegram chat: error alerts and what players write after /paysupport come here, and only
    // here do /refund, /payments and /reply work.
    "ADMIN_CHAT_ID": "364316344",
    // Days the server was down (YYYY-MM-DD, separated by commas): the daily streak takes them as played, breaking
    // nothing and spending no freeze. The admin's bot command /outage <day> adds more without a deploy (outages.ts).
    "OUTAGE_DAYS": "",
    // PLACEHOLDER (empty): set to the real release moment before the deploy, e.g. "2026-10-27T09:00:00Z".
    // The moment of the Shattered release (ISO, UTC): every profile made before it is sent the «Первопроходец»
    // letter, as is every profile kept before profiles noted their birth (pioneer.ts). Set it before the deploy.
    "RELEASE_AT": ""
  },
  // Secrets: npx wrangler secret put BOT_TOKEN, and WEBHOOK_SECRET for the bot's webhook (/telegram/webhook);
  // REPORT_KEY reads the error reports back (scripts/reports.mjs); DAILY_SECRET is what the daily dungeon's seed is
  // derived from (daily-seed.ts): npx wrangler secret put DAILY_SECRET (any long random string; without it a public
  // development value is used, so set it before the deploy and never change it mid-day).
  // Logs: what the server itself logs (console.error) is kept; Cloudflare's invocation logs are off, because
  // they record each request's URL, and a room's WebSocket URL carries the player's Telegram init data.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }
}
